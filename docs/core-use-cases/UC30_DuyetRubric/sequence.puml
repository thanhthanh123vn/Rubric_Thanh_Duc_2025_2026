@startuml
autonumber
title UC-30 Phê duyệt Rubric
actor "Trưởng khoa / Trưởng bộ môn" as Reviewer
boundary "RubricApprovalPage" as UI
control "RubricController" as Controller
control "RubricService" as Service
participant "UserClient" as UserClient
participant "CourseClient" as CourseClient
database "RubricRepository" as RubricRepo
database "ApprovalRecordRepository" as ApprovalRepo
database "VersionHeadRepository" as HeadRepo

Reviewer -> UI : Mở danh sách Rubric chờ duyệt
UI -> Controller : getRubricsForApproval(PENDING)
Controller -> Service : getRubricsForApproval(reviewerId, PENDING)
Service -> UserClient : getUser(reviewerId)
UserClient --> Service : Vai trò và đơn vị
Service -> CourseClient : getCoursesInApprovalScope(...)
CourseClient --> Service : Danh sách học phần
Service -> RubricRepo : findByStatusAndCourseIds(PENDING, courseIds)
RubricRepo --> Service : Danh sách Rubric
Service --> UI : Rubric[]

Reviewer -> UI : Phê duyệt / Từ chối
UI -> Controller : reviewRubric(rubricId, request)
Controller -> Service : reviewRubric(rubricId, reviewerId, request)
Service -> UserClient : getUser(reviewerId)
Service -> RubricRepo : findById(rubricId)
Service -> ApprovalRepo : findLatestPending(rubricId)

alt Sai quyền, phạm vi hoặc trạng thái
  Service --> Controller : Security/State Exception
  Controller --> UI : 403/409 + thông báo
else Từ chối nhưng thiếu phản hồi
  Service --> Controller : ValidationException
  Controller --> UI : 400 + yêu cầu nhập lý do
else Yêu cầu hợp lệ
  opt Phê duyệt Rubric version
    Service -> HeadRepo : moveHead(rootId, lecturerId, rubricId)
  end
  Service -> RubricRepo : save(APPROVED/REJECTED, review metadata)
  Service -> ApprovalRepo : save(approval decision)
  Service --> Controller : Rubric đã cập nhật
  Controller -> CourseClient : writeLog(REVIEW_RUBRIC)
  Controller --> UI : 200 + kết quả
  UI --> Reviewer : Hiển thị trạng thái mới
end
@enduml
