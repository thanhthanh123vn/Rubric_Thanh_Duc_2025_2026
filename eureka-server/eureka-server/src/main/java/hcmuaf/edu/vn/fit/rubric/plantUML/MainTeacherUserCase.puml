@startuml
left to right direction
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor LightCyan
  BorderColor DarkCyan
}

actor "Giảng Viên Chính" as MainTeacher

package "Quản Lý Đề Cương & Chuẩn Đầu Ra" {
  usecase "13. Quản lý đề cương" as UC_Syllabus
  usecase "13.1 Tạo CLO + Rubric trọng số" as UC_CreateRubric
  usecase "13.2 Xóa CLO + Rubric trọng số" as UC_DelRubric
  usecase "13.3 Sửa CLO + Rubric trọng số" as UC_EditRubric
  usecase "13.4 Xem CLO + Rubric trọng số" as UC_ViewRubric
  usecase "13.5 Xem Ma trận Rubric" as UC_Matrix
}

MainTeacher --> UC_Syllabus
UC_Syllabus <.. UC_CreateRubric : <<extend>>
UC_Syllabus <.. UC_DelRubric : <<extend>>
UC_Syllabus <.. UC_EditRubric : <<extend>>
UC_Syllabus <.. UC_ViewRubric : <<extend>>
UC_Syllabus <.. UC_Matrix : <<extend>>
@enduml